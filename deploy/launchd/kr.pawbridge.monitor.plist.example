<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PYTHONDONTWRITEBYTECODE</key>
		<string>1</string>
	</dict>
	<key>Label</key>
	<string>kr.pawbridge.monitor</string>
	<key>ProgramArguments</key>
	<array>
		<string>@@PYTHON@@</string>
		<string>@@RUNTIME@@/scripts/mac_background_jobs.py</string>
		<string>monitor</string>
		<string>@@PRIVATE_MONITOR_CONFIG@@</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>@@RUNTIME@@/logs/monitor.stderr.log</string>
	<key>StandardOutPath</key>
	<string>@@RUNTIME@@/logs/monitor.stdout.log</string>
	<key>StartInterval</key>
	<integer>60</integer>
	<key>Umask</key>
	<integer>63</integer>
	<key>WorkingDirectory</key>
	<string>@@RUNTIME@@</string>
</dict>
</plist>
