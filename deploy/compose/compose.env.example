# 비공개 compose.env 형식. 실제 파일은 Git 밖 운영 폴더에 둔다.
OPERATING_PROJECT=pawbridge-prod
OPERATING_UID=501
OPERATING_GID=20
OPERATING_OWNER=<owner-label>
# postgres.env, redis.env, redis.conf, native-relay.env
OPERATING_SECRETS=/absolute/path/to/operating/secrets
# config/native-relay.conf
OPERATING_STATE=/absolute/path/to/operating/state
# pg_hba.conf, local-native-access.conf, backup-job.json (deploy/config 사본)
BACKGROUND_CONFIG=/absolute/path/to/background/config

# docker image inspect로 확인한 고정 이미지 ID(sha256:...)
POSTGRES_IMAGE=sha256:<64 hex>
REDIS_IMAGE=sha256:<64 hex>
NGINX_IMAGE=sha256:<64 hex>
PYTHON_API_IMAGE=sha256:<64 hex>
PHOTO_IMAGE=sha256:<64 hex>
BACKUP_IMAGE=sha256:<64 hex>
MONOLITH_IMAGE=pawbridge-monolith:prod-<sha12>

# 비공개 env 파일
PYTHON_API_ENV_FILE=/absolute/path/to/python-api.env
PHOTO_ENV_FILE=/absolute/path/to/photo.env
MONOLITH_ENV_FILE=/absolute/path/to/monolith.active.env

R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_CREDENTIALS=/absolute/path/to/backup/credentials
BACKUP_WORK=/absolute/path/to/backup-work
# origin/main 커밋의 deploy/scripts 사본
MAC_SCRIPTS=/absolute/path/to/scripts-<sha>

CLOUDFLARED_UID=501
CLOUDFLARED_GID=20
CLOUDFLARED_TOKEN_FILE=/absolute/path/to/cloudflare-tunnel-token.txt
