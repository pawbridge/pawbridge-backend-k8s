# animal-service Environment Variables
# 이 파일을 복사하여 .env 파일로 만들고 실제 값을 입력하세요.
# cp .env.example .env (Linux/Mac)
# copy .env.example .env (Windows)

# ==========================================
# Spring Profile 설정
# ==========================================
# 로컬 개발: local, 운영: prod
# 이 설정으로 application-local.yml이 자동 로드됩니다.
SPRING_PROFILES_ACTIVE=local

# ==========================================
# APMS (동물보호관리시스템) API 설정
# ==========================================
# 공공데이터포털(data.go.kr)에서 발급받은 서비스 키
# 발급 URL: https://www.data.go.kr/data/15098931/openapi.do
APMS_SERVICE_KEY=your-apms-service-key-here

# 동반여행: 목록·공통 상세는 기존 반려동물 API, 일괄 동반 상세는 국문 API.
# 실제 키는 운영 Vault에서 주입합니다. 이 예제에는 인증정보를 저장하지 않습니다.
TOURAPI_ENABLED=false
TOURAPI_SERVICEKEY=your-pet-tour-service-key-here
# V6 마이그레이션 적용 및 별도 키 주입 후 활성화하세요.
TOURAPI_BULKPETENABLED=false
TOURAPI_BULKSERVICEKEY=your-korean-tour-service-key-here
TOURAPI_MAXBULKPAGESPERRUN=10

# ==========================================
# 데이터베이스 설정 (선택사항)
# ==========================================
# application-local.yml에 기본값이 있으므로 재정의가 필요한 경우만 사용
# DB_URL=your-database-url
# DB_USERNAME=your-database-username
# DB_PASSWORD=your-database-password

# ==========================================
# Kafka 설정 (선택사항)
# ==========================================
# KAFKA_BOOTSTRAP_SERVERS=your-kafka-bootstrap-servers
