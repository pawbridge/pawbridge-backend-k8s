@@ -0,0 +1,18 @@
+# PawBridge Mac image-inference adapter. Models and preprocessing stay unchanged.
+import torch
+import torch.nn.functional as F
+
+
+def scaled_dot_product_attention(q, k, v, attn_mask=None, dropout_p=0.0, is_causal=False):
+    """Bound large, unmasked MPS attention without splitting the softmax key axis.
+
+    CUDA, training, masks, causal attention, and short sequences keep PyTorch's
+    original path. This narrow adapter is for the pinned SAM3 image model only.
+    """
+    if (q.device.type != "mps" or torch.is_grad_enabled() or q.shape[-2] <= 1024
+            or k.shape[-2] <= 1024 or attn_mask is not None or dropout_p != 0.0 or is_causal):
+        return F.scaled_dot_product_attention(q, k, v, attn_mask, dropout_p, is_causal)
+    # Each query still attends to every key; only independent query rows split.
+    parts = [F.scaled_dot_product_attention(part, k, v)
+             for part in q.split(512, dim=-2)]
+    return torch.cat(parts, dim=-2)
